# Free-tier AI provider for Phase 1 development.
# Get a free key at https://console.groq.com/keys (no cost, generous limits).
# The provider layer (src/llmProvider.js) is swappable — replace this block
# with OPENAI_API_KEY or ANTHROPIC_API_KEY later without touching orchestrator.js.
#
# Model options on Groq's free/developer tier (verified against their current
# model list — this changes over time, check https://console.groq.com/docs/models
# if you hit a "model not found" error):
#   openai/gpt-oss-120b  <- default, best quality, still fast
#   openai/gpt-oss-20b   <- faster/cheaper, slightly less capable
# Note: llama-3.3-70b-versatile and llama-3.1-8b-instant were moved to
# Enterprise-only access and will 404 on a free-tier key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=4000

# Comma-separated list of origins allowed to connect (your frontend's dev URL)
CORS_ORIGIN=http://localhost:5173
